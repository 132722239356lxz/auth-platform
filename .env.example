# =============================================================================
# auth-platform 环境变量模板
# =============================================================================
# 使用方式：
#   cp .env.example .env
#   然后按注释填入真实值
#
# 安全要求：
#   1. .env 已被 .gitignore 忽略，严禁提交到代码仓库
#   2. 所有密码/密钥必须是随机强口令，禁止使用下方示例中的占位值
#   3. 生产环境建议改用 CI/CD 的 Secret 变量或 K8s Secret 注入，而非落盘 .env
#
# 生成随机密码的参考命令：
#   openssl rand -base64 32
# =============================================================================

# ---------- 镜像与版本 ----------
# 镜像仓库地址（末尾不带斜杠），例如 registry.example.com/auth-platform
IMAGE_REGISTRY=auth-platform
# 应用版本号，同时作为镜像 tag；生产部署的回滚依据
APP_VERSION=1.0.0

# ---------- 服务端口（dev 对外暴露用） ----------
# 端口冲突排查（启动前建议先确认）：
#   Windows: netstat -ano | findstr "LISTENING" | findstr ":80 :3306 :8080 :8848 "
#   Linux  : ss -tlnp | grep -E ':(80|3306|8080|8848)\s'
# 若某端口已被占用（如本机已装 MySQL 占用 3306、其它 Web 服务占用 80），请修改下方对应值。
GATEWAY_PORT=8080
# 默认 3307：本机常已安装 MySQL 占用 3306
MYSQL_PORT=3307
REDIS_PORT=6379
NACOS_PORT=8848
RABBITMQ_MGMT_PORT=15672
# 前端访问端口
# 默认 8082：80 端口常被其它 Web 服务（如 Nginx）占用
WEB_PORT=8082
APP_PORT=8081

# ---------- 基础设施地址 ----------
NACOS_ADDR=nacos:8848

# ---------- MySQL ----------
# 生产必须是强随机密码，禁止使用 root123 / 123456 等弱口令
MYSQL_ROOT_PASSWORD=请替换为强随机密码

# ---------- Redis ----------
# 生产环境 Redis 密码（prod 编排已启用 requirepass）
REDIS_PASSWORD=请替换为强随机密码

# ---------- Nacos ----------
NACOS_USERNAME=nacos
NACOS_PASSWORD=请替换为强随机密码
# Nacos 服务端身份识别（鉴权用），必须修改，勿用默认值
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=请替换为随机值
# Nacos JWT 签名密钥，必须 ≥32 位随机字符串。
# 切勿使用官方示例默认值 SecretKey0123456789012345678901234567890123456789...，
# 否则攻击者可自行签发 Nacos 身份 Token 绕过鉴权（已知默认密钥漏洞）
NACOS_AUTH_TOKEN=请替换为至少32位的随机字符串

# ---------- RabbitMQ ----------
RABBITMQ_USER=请替换为自定义账号
RABBITMQ_PASS=请替换为强随机密码

# ---------- OAuth2 门户客户端 ----------
# 用于授权码换 Token 的服务端凭证，切勿泄露给前端
PORTAL_CLIENT_ID=admin-web
PORTAL_CLIENT_SECRET=请替换为强随机密钥
# 走容器内网直接调用网关，避免绕公网
PORTAL_TOKEN_ENDPOINT=http://gateway:8080/auth-server/oauth2/token

# ---------- API 文档开关 ----------
# 生产必须为 false，否则接口签名会对外暴露
API_DOCS_ENABLED=true
