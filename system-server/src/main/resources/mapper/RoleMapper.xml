<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.liang.xz.system.mapper.RoleMapper">

    <resultMap id="BaseResultMap" type="com.liang.xz.system.entity.RoleEntity">
        <id column="id" property="id"/>
        <result column="role_code" property="roleCode"/>
        <result column="role_name" property="roleName"/>
        <result column="description" property="description"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="enabled" property="enabled"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT * FROM sys_role ORDER BY sort_order ASC, create_time DESC
    </select>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM sys_role WHERE id = #{id}
    </select>

    <select id="findByRoleCode" resultMap="BaseResultMap">
        SELECT * FROM sys_role WHERE role_code = #{roleCode}
    </select>

    <select id="findByQuery" resultMap="BaseResultMap">
        SELECT * FROM sys_role
        <where>
            <if test="keyword != null and keyword != ''">
                AND (role_code LIKE CONCAT('%', #{keyword}, '%')
                OR role_name LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>
        </where>
        ORDER BY sort_order ASC, create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countByQuery" resultType="long">
        SELECT COUNT(*) FROM sys_role
        <where>
            <if test="keyword != null and keyword != ''">
                AND (role_code LIKE CONCAT('%', #{keyword}, '%')
                OR role_name LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>
        </where>
    </select>

    <select id="findRoleCodesByUserId" resultType="string">
        SELECT r.role_code FROM sys_role r
        INNER JOIN sys_user_role ur ON r.id = ur.role_id
        WHERE ur.user_id = #{userId} AND r.enabled = 1
    </select>

    <select id="findRoleIdsByUserId" resultType="long">
        SELECT role_id FROM sys_user_role WHERE user_id = #{userId}
    </select>

    <insert id="insert" parameterType="com.liang.xz.system.entity.RoleEntity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_role (role_code, role_name, description, sort_order, enabled)
        VALUES (#{roleCode}, #{roleName}, #{description}, #{sortOrder}, #{enabled})
    </insert>

    <update id="update" parameterType="com.liang.xz.system.entity.RoleEntity">
        UPDATE sys_role
        SET role_code = #{roleCode}, role_name = #{roleName}, description = #{description},
            sort_order = #{sortOrder}, enabled = #{enabled}
        WHERE id = #{id}
    </update>

    <insert id="insertUserRole">
        INSERT INTO sys_user_role (user_id, role_id) VALUES (#{userId}, #{roleId})
    </insert>

    <insert id="insertRoleMenu">
        INSERT INTO sys_role_menu (role_id, menu_id) VALUES (#{roleId}, #{menuId})
    </insert>

    <delete id="deleteRoleMenus">
        DELETE FROM sys_role_menu WHERE role_id = #{roleId}
    </delete>

    <delete id="deleteUserRoles">
        DELETE FROM sys_user_role WHERE user_id = #{userId}
    </delete>

    <delete id="deleteById">
        DELETE FROM sys_role WHERE id = #{id}
    </delete>

</mapper>
